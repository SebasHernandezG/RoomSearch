# URL del backend para el proxy de Vite en desarrollo.
#
# En desarrollo y en produccion el frontend usa rutas relativas
# (/api/properties). Este valor solo cambia a donde las reenvia Vite,
# no lo que pide el navegador.
VITE_API_URL=http://127.0.0.1:8001

# Solo si el frontend se sirve desde un dominio distinto al de la API.
# Vacio = mismo origen, que es lo normal y lo recomendado.
VITE_API_BASE=
