NODE_ENV=production
PORT=3000
# Use the final HTTPS address supplied by your hosting provider or your domain.
APP_URL=https://your-service.onrender.com
# Mount persistent storage at /app/data. Do not use an in-memory database.
DB_DATABASE=/app/data/roomies.sqlite
# Generate once with: bun -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
# Optional Google sign-in. Register APP_URL + /api/auth/google/callback in Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave blank to derive the callback from APP_URL in production.
ELYSIA_GOOGLE_REDIRECT_URI=
# Server-only key for Google's Routes API.
GOOGLE_MAPS_API_KEY=
# Public browser key; restrict it to your domain in Google Cloud.
# These VITE_ values must be supplied at image build time.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
