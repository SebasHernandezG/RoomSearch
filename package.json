{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "roomies-elysia",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node node_modules/concurrently/dist/bin/index.js --kill-others --names API,WEB --prefix-colors green,cyan \"bun run dev:server\" \"bun run dev:web\"",
        "dev:server": "bun --hot src/server/index.ts",
        "dev:web": "node node_modules/vite/bin/vite.js",
        "build": "node node_modules/vite/bin/vite.js build",
        "start": "bun src/server/index.ts",
        "test": "bun test",
        "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@elysiajs/static": "^1.4.10",
        "@fontsource-variable/geist": "^5.3.0",
        "@googlemaps/js-api-loader": "^2.1.1",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.3.0",
        "elysia": "^1.4.30",
        "lucide-react": "^1.46.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "shadcn": "^4.21.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/bun": "latest",
        "@types/google.maps": "^3.66.3",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.5",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0"
    }
}
